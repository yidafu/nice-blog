name: Deploy Static Blog

on:
  push:
    branches: [main]
  # 可选：每天自动构建（拉取飞书文档最新内容）
  schedule:
    - cron: '0 0 * * *'
  # 可选：手动触发
  workflow_dispatch:

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'
          cache: 'gradle'

      - name: Build static site
        env:
          FEISHU_APP_ID: ${{ secrets.FEISHU_APP_ID }}
          FEISHU_APP_SECRET: ${{ secrets.FEISHU_APP_SECRET }}
        run: |
          chmod +x ./gradlew
          chmod +x ./nice-blog.sh
          ./nice-blog.sh build

      - name: Deploy to GitHub Pages
        uses: peaceiris/actions-gh-pages@v3
        with:
          github_token: ${{ secrets.GITHUB_TOKEN }}
          publish_dir: ./cli/output
          cname: blog.yidafu.dev  # 可选：自定义域名

      # 或者部署到 Cloudflare Pages
      # - name: Publish to Cloudflare Pages
      #   uses: cloudflare/pages-action@v1
      #   with:
      #     apiToken: ${{ secrets.CLOUDFLARE_API_TOKEN }}
      #     accountId: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
      #     projectName: nice-blog
      #     directory: ./cli/output
      #     gitHubToken: ${{ secrets.GITHUB_TOKEN }}

# 使用步骤：
# 1. 复制此文件为 .github/workflows/deploy-static.yml
# 2. 在 GitHub 仓库设置中添加 Secrets：
#    - FEISHU_APP_ID（如果使用飞书）
#    - FEISHU_APP_SECRET（如果使用飞书）
# 3. 推送代码，自动触发构建和部署


