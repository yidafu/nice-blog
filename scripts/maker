#!/bin/bash
# NiceMaker CLI 便捷脚本

cd "$(dirname "$0")"

case "$1" in
  build)
    echo "🔨 Building static site..."
    ./gradlew :nicemaker:jvmRun --args="build -c $(pwd)/nice.yaml ${@:2}" --console=plain
    ;;

  serve)
    # 智能解析参数
    if [[ "$2" =~ ^[0-9]+$ ]]; then
      # 第二个参数是数字，作为端口
      PORT="$2"
      OUTPUT_DIR="${3:-nicemaker/output}"
    else
      # 第二个参数不是数字，作为目录
      PORT="3000"
      OUTPUT_DIR="${2:-nicemaker/output}"
    fi

    echo "🌐 Starting preview server on port $PORT..."
    echo "   Serving: $OUTPUT_DIR"
    ./gradlew :nicemaker:jvmRun --args="serve -p $PORT -d $OUTPUT_DIR" --console=plain
    ;;

  new)
    if [ -z "$2" ]; then
      echo "❌ Please provide article title"
      echo "   Usage: ./maker new \"My Article\""
      exit 1
    fi
    ./gradlew :nicemaker:jvmRun --args="new \"$2\" ${@:3}" --console=plain
    ;;

  *)
    echo "📦 NiceMaker - Static Site Generator"
    echo ""
    echo "Usage:"
    echo "  ./maker <command> [options]"
    echo ""
    echo "Commands:"
    echo "  build              Generate static site"
    echo "  serve [port|dir]   Start preview server (default port: 3000, dir: output)"
    echo "  new <title>        Create new article"
    echo ""
    echo "Examples:"
    echo "  ./maker build"
    echo "  ./maker serve                # Port 3000, default output dir (./output)"
    echo "  ./maker serve 8080           # Port 8080, default output dir"
    echo "  ./maker serve ./output       # Port 3000, custom output dir"
    echo "  ./maker serve 8080 ./output  # Port 8080, custom output dir"
    echo "  ./maker new \"My First Post\""
    ;;
esac

